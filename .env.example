# Waypoint does not load .env files automatically.
# For a local server process:
#   cp .env.example .env
#   set -a; source .env; set +a
#   cargo run --package waypoint-api
#
# For the Docker Compose stack:
#   cp .env.example .env
#   docker compose up --build --detach

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Used by compose.yaml. Generate an alphanumeric password to keep the composed
# DATABASE_URL valid:
#   openssl rand -hex 24
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Used when waypoint-api runs directly on the host. Percent-encode special
# characters in the password.
DATABASE_URL=postgresql://waypoint:replace-with-a-random-hex-password@127.0.0.1:5432/waypoint

# Host port published by compose.yaml. The API remains bound to localhost.
WAYPOINT_PORT=8787

# -----------------------------------------------------------------------------
# Synchronization API
# -----------------------------------------------------------------------------

# Shared Bearer token used by every client. It grants full access to this
# single-user Waypoint instance. Generate at least 32 random bytes:
#   openssl rand -hex 32
WAYPOINT_SYNC_TOKEN=replace-with-a-random-64-character-token

# Listener in IP:PORT form. Keep the host default behind a TLS reverse proxy.
# The container overrides this value with 0.0.0.0:8787 inside its private
# network.
WAYPOINT_BIND=127.0.0.1:8787

# tracing-subscriber filter. Examples: debug, waypoint_api=debug,sqlx=warn.
RUST_LOG=info

# Optional Firebase service account JSON. Keep this secret out of Git and
# inject it as one compact JSON line through your deployment platform.
# Generate a compact local value with:
#   jq -c . /path/to/firebase-service-account.json
# WAYPOINT_FIREBASE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Desktop and Android clients
# -----------------------------------------------------------------------------

# Directory that contains waypoint.sqlite3. When unset, Qt uses the platform's
# application data directory.
# WAYPOINT_DATA_DIR=${HOME}/.local/share/waypoint

# Stable device identifier containing 1 to 128 characters. When unset, the
# client derives one from the machine.
# WAYPOINT_DEVICE_ID=desktop-00000000-0000-4000-8000-000000000000

# Android Firebase application values. All four are optional; without them the
# app uses periodic synchronization instead of push wakeups. These identify the
# Firebase Android application but are not the service-account private key.
# WAYPOINT_FIREBASE_APPLICATION_ID=
# WAYPOINT_FIREBASE_API_KEY=
# WAYPOINT_FIREBASE_PROJECT_ID=
# WAYPOINT_FIREBASE_SENDER_ID=

# -----------------------------------------------------------------------------
# Android build
# -----------------------------------------------------------------------------

# arm64-v8a targets physical devices; x86_64 targets an emulator.
# ANDROID_ABI=arm64-v8a
# ANDROID_BUILD_TYPE=Debug
# QT_ANDROID_ROOT=${HOME}/.local/qt/6.9.3/android_arm64_v8a
# QT_HOST_ROOT=${HOME}/.local/qt/6.9.3/gcc_64
# ANDROID_SDK_ROOT=${HOME}/.local/android-sdk
# ANDROID_NDK_ROOT=${ANDROID_SDK_ROOT}/ndk/27.2.12479018
# JAVA_HOME=${HOME}/.local/share/mise/installs/java/temurin-17.0.20+8

# Release signing. Never commit the keystore or passwords.
# QT_ANDROID_SIGN_APK=ON
# QT_ANDROID_KEYSTORE_PATH=/absolute/path/to/waypoint-release.jks
# QT_ANDROID_KEYSTORE_ALIAS=waypoint
# QT_ANDROID_KEYSTORE_STORE_PASS=
# QT_ANDROID_KEYSTORE_KEY_PASS=

# -----------------------------------------------------------------------------
# Container build
# -----------------------------------------------------------------------------

# The Dockerfile fixes this at zero for reproducible dependency caching.
# CARGO_INCREMENTAL=0
