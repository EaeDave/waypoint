# Waypoint não carrega arquivos .env automaticamente.
# Para executar o servidor diretamente:
#   cp .env.example .env
#   set -a; source .env; set +a
#   cargo run --package waypoint-api
#
# Para executar o contêiner usando um PostgreSQL local no Linux:
#   docker build --tag waypoint-api .
#   docker run --rm --env-file .env --network host waypoint-api

# -----------------------------------------------------------------------------
# API de sincronização — obrigatórias
# -----------------------------------------------------------------------------

# URL PostgreSQL completa. Caracteres especiais da senha devem estar codificados
# para URL. Gere uma senha hexadecimal segura com:
#   openssl rand -hex 24
DATABASE_URL=postgresql://waypoint:troque-esta-senha@127.0.0.1:5432/waypoint

# Token Bearer compartilhado pelos clientes desktop/Android e pela API.
# Gere 32 bytes aleatórios (64 caracteres hexadecimais) com:
#   openssl rand -hex 32
# Alternativa sem OpenSSL:
#   python -c 'import secrets; print(secrets.token_hex(32))'
WAYPOINT_SYNC_TOKEN=troque-pelo-token-aleatorio-gerado

# -----------------------------------------------------------------------------
# API de sincronização — opcionais
# -----------------------------------------------------------------------------

# Endereço de escuta no formato IP:PORTA.
# Prefira 127.0.0.1 quando houver proxy reverso ou `--network host`. Use
# 0.0.0.0:8787 para publicar a porta de uma rede isolada de contêiner.
# Padrão do binário: 127.0.0.1:8787; padrão da imagem: 0.0.0.0:8787.
WAYPOINT_BIND=127.0.0.1:8787

# Filtro do tracing-subscriber. Padrão: info.
# Exemplos: debug | waypoint_api=debug,sqlx=warn | warn
RUST_LOG=info

# -----------------------------------------------------------------------------
# Aplicativo e daemon desktop — opcionais
# -----------------------------------------------------------------------------

# Diretório que conterá waypoint.sqlite3. Quando ausente, o Qt usa o diretório
# de dados local da plataforma. Crie o exemplo com:
#   mkdir -p "$HOME/.local/share/waypoint"
# WAYPOINT_DATA_DIR=${HOME}/.local/share/waypoint

# Identificador estável e único deste dispositivo, com 1 a 128 caracteres.
# Quando ausente, o cliente deriva um identificador da máquina. Para gerar um:
#   uuidgen
# Alternativa sem uuidgen:
#   python -c 'import uuid; print(uuid.uuid4())'
# WAYPOINT_DEVICE_ID=desktop-00000000-0000-4000-8000-000000000000

# -----------------------------------------------------------------------------
# Build Android via bin/build-android — overrides opcionais
# -----------------------------------------------------------------------------

# Descomente apenas quando as ferramentas não estiverem nos caminhos padrão do
# script. Carregue o arquivo com `source .env` antes de executar o build.
# ABI usada pelo bin/build-android. Use arm64-v8a para aparelhos físicos e
# x86_64 para o emulador local.
# ANDROID_ABI=arm64-v8a
# QT_ANDROID_ROOT=${HOME}/.local/qt/6.9.3/android_arm64_v8a
# QT_HOST_ROOT=${HOME}/.local/qt/6.9.3/gcc_64
# ANDROID_SDK_ROOT=${HOME}/.local/android-sdk
# ANDROID_NDK_ROOT=${ANDROID_SDK_ROOT}/ndk/27.2.12479018
# JAVA_HOME=${HOME}/.local/share/mise/installs/java/temurin-17.0.20+8

# -----------------------------------------------------------------------------
# Build do contêiner — interna
# -----------------------------------------------------------------------------

# O Dockerfile fixa esta variável em 0 no estágio de compilação para evitar
# artefatos incrementais no cache. Normalmente não deve ser alterada.
# CARGO_INCREMENTAL=0
