#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
install_prefix="${HOME}/.local"
plugin_target="${HOME}/.config/omarchy/plugins/io.waypoint.bar"

for command in cmake ninja c++ pkg-config; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "${command}" >&2
    exit 1
  fi
done

cmake -S "${project_root}" -B "${project_root}/build/dev" -G Ninja \
  -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON
cmake --build "${project_root}/build/dev"
cmake --install "${project_root}/build/dev" --prefix "${install_prefix}"

mkdir -p "${HOME}/.config/systemd/user" "${HOME}/.config/waypoint" "$(dirname "${plugin_target}")"
install -m 0644 "${project_root}/packaging/systemd/waypointd.service" "${HOME}/.config/systemd/user/waypointd.service"
ln -sfn "${project_root}/plugins/omarchy-waypoint" "${plugin_target}"

systemctl --user daemon-reload
systemctl --user enable waypointd.service
systemctl --user restart waypointd.service

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins
  omarchy plugin enable io.waypoint.bar
  omarchy bar move io.waypoint.bar --section center
fi

printf 'Waypoint is built and installed in %s\n' "${install_prefix}"
