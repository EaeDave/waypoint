<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_entry_row"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/widget_entry_status"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:padding="11dp"
        android:src="@drawable/waypoint_widget_task_pending" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_entry_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_entry_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="3"
            android:textColor="#FFAEB2BF"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
