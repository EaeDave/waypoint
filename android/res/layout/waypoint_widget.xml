        <ImageButton
            android:id="@+id/widget_previous_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Mês anterior"
            android:padding="9dp"
            android:src="@drawable/waypoint_widget_previous" />

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="WAYPOINT"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_next_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Próximo mês"
            android:padding="9dp"
            android:src="@drawable/waypoint_widget_next" />
    </LinearLayout>

