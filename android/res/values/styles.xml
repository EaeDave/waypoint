<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#7AA2F7</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:navigationBarColor">#08090B</item>
        <item name="android:statusBarColor">#08090B</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="WidgetDialogTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="WidgetHistoryTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">#979FEC</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">95%</item>
    </style>
</resources>
